# =============================================================================
#  Soop Judge — Konfiguration
# =============================================================================
#
#  Diese Datei ist die Vorlage. Kopieren, die beiden Pflichtwerte setzen,
#  fertig:
#
#      cp .env.example .env
#
#  Die .env selbst steht in .gitignore und gehört nicht ins Repository.
#  Aus derselben Datei richtet Docker Compose die Datenbank ein und liest das
#  Backend seine Konfiguration — das Passwort steht also nur an einer Stelle.
#
#  PFLICHT sind genau zwei Werte:  POSTGRES_PASSWORD  und  Admin__Password
#  Alles andere kann so bleiben.
#
# =============================================================================


# -----------------------------------------------------------------------------
#  Datenbank
# -----------------------------------------------------------------------------

# PFLICHT — Passwort des Datenbankbenutzers.
#
# Ändern wirkt sofort: der db-Dienst gleicht das Passwort bei jedem Start an
# diese Datei an. Ein "docker compose up -d" genügt, das Volume muss dafür
# nicht neu angelegt werden.
POSTGRES_PASSWORD=bitte-aendern

# Optional — Name der Datenbank und des Benutzers.
POSTGRES_DB=soopworkshop
POSTGRES_USER=postgres


# -----------------------------------------------------------------------------
#  Admin-Bereich
# -----------------------------------------------------------------------------

# PFLICHT — schützt /admin und alle Endpunkte unter api/admin/.
#
# Fehlt der Wert, startet das Backend nicht. Das ist Absicht: ein klarer
# Abbruch ist besser als ein stiller Start ohne Zugangsschutz. Es gibt genau
# dieses eine Passwort und keine Benutzerverwaltung.
Admin__Password=bitte-aendern


# -----------------------------------------------------------------------------
#  Auswertung
# -----------------------------------------------------------------------------
#
#  Der doppelte Unterstrich trennt die Konfigurationsebenen: aus
#  Evaluation__MaxConcurrency wird im Backend Evaluation:MaxConcurrency.
#  Alle Zeitgrenzen sind Sekunden Wanduhrzeit.

# Wie viele Abgaben gleichzeitig ausgewertet werden. Begrenzt damit die Anzahl
# paralleler JVM-Prozesse. Bei wenigen Kernen konkurrieren die Prozesse und
# brauchen länger — dann eher die Zeitgrenzen anheben als diesen Wert senken.
Evaluation__MaxConcurrency=10

# Zeitgrenze für javac.
Evaluation__CompileTimeoutSeconds=30

# Zeitgrenze je Durchlauf eines Konsolen-Testfalls. Fängt Endlosschleifen ab.
Evaluation__RunTimeoutSeconds=10

# Zeitgrenze für den JUnit-Lauf. Deckt alle Testmethoden einer Aufgabe
# zusammen ab und ist deshalb großzügiger.
Evaluation__JUnitRunTimeoutSeconds=30

# Obergrenze der Warteschlange. Ist sie voll, wartet das Einreihen, statt die
# Abgabe abzulehnen.
Evaluation__QueueCapacity=100


# -----------------------------------------------------------------------------
#  Netzwerk
# -----------------------------------------------------------------------------

# Port, unter dem das Tool im Netz erreichbar ist. Nur ändern, wenn 80 schon
# belegt ist oder die IT einen anderen Port vorgibt.
#HTTP_PORT=80
