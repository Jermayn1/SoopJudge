<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>soopworkshop-backend-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <!--
    Das JUnit-Standalone-JAR wandert mit ins Ausgabeverzeichnis. Damit greift der
    Standardpfad aus Evaluation:JUnitJarPath sowohl beim lokalen Start als auch im
    veröffentlichten Stand - beide lösen relativ zu AppContext.BaseDirectory auf.
  -->
  <ItemGroup>
    <None Include="..\..\lib\*.jar" Link="lib\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SoopWorkshop.Backend.Application\SoopWorkshop.Backend.Application.csproj" />
    <ProjectReference Include="..\SoopWorkshop.Backend.Infrastructure\SoopWorkshop.Backend.Infrastructure.csproj" />
    <ProjectReference Include="..\SoopWorkshop.Shared\SoopWorkshop.Shared.csproj" />
  </ItemGroup>

</Project>
